# Supabase Configuration (Public)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role (Server-side only; never ship in app bundle)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Sensitive Keys (MOVE THESE TO SUPABASE SECRETS)
# Do NOT prefix with EXPO_PUBLIC_ anymore.
# Use: 'supabase secrets set GOOGLE_MAPS_API_KEY=...'
# Use: 'supabase secrets set OPENROUTER_API_KEY=...'
