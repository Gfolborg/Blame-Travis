# Supabase Configuration (Public)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_restricted_mobile_maps_sdk_key
EXPO_PUBLIC_FOURSQUARE_API_KEY=optional_client_visible_key_if_used
# Optional temporary override for discovery fallback when edge deploys lag.
# Keep unset/false for production.
EXPO_PUBLIC_ENABLE_CLIENT_DISCOVERY_FALLBACK=false

# Supabase Service Role (Server-side only; never ship in app bundle)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
EDGE_CRON_SECRET=shared_secret_for_scheduler_only

# Sensitive Provider/LLM Keys (MOVE THESE TO SUPABASE SECRETS)
# Do NOT expose these in EXPO_PUBLIC_* env vars.
# Use: 'supabase secrets set GOOGLE_MAPS_API_KEY=...'
# Use: 'supabase secrets set FOURSQUARE_API_KEY=...'
# Use: 'supabase secrets set OPENROUTER_API_KEY=...'
# Use: 'supabase secrets set EDGE_CRON_SECRET=...'
